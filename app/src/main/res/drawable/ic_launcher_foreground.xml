        android:fillColor="#6750A4"
        android:pathData="M44,28H64A24,24 0,0 1,64,76H44A24,24 0,0 1,44,28Z" />

    <!-- 左眼 -->
    <path
        android:fillColor="#EADDFF"
        android:pathData="M42,50m-5.5,0a5.5,5.5 0,1 0,11,0a5.5,5.5 0,1 0,-11,0" />

    <!-- 右眼 -->
    <path
        android:fillColor="#EADDFF"
        android:pathData="M66,50m-5.5,0a5.5,5.5 0,1 0,11,0a5.5,5.5 0,1 0,-11,0" />

    <!-- 微笑 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M46,60Q54,68 62,60"
        android:strokeColor="#EADDFF"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
